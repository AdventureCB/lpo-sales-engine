{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LPO Queue Runner",
  "version": "0.2.2",
  "identifier": "com.lonepeakoverland.queuerunner",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
